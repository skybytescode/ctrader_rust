/target
/gen
.prod-build/
run_production.sh

# Environment variables with sensitive credentials
.env
.env.*

# Python bytecode cache
__pycache__/
*.pyc
*.nbc
*.nbi

# DuckDB database and temp files
Bots_db/
*.duckdb
*.duckdb.wal

# ML model weights (large binaries — metrics/feature names are tracked)
ml/trained/*.json
ml/trained/*.pkl
ml/trained/*.pt
ml/trained/*.txt
!ml/trained/*_metrics*.json

# Generated ML feature CSVs (rebuilt via UI button)
ml/ml_unified_features.csv

# Claude Code: ignore local settings, but TRACK skills/ and agents/ — these are
# app source (the SKILL.md playbooks are include_str!'d into the binary) and must
# travel with the repo. Without this they're lost on clone (→ placeholder stubs).
.claude/*
!.claude/skills/
!.claude/agents/

# Econcal proxy (separate git repo)
econcal/

# Runtime artifacts
scraper_log.txt
econcal_comparison_*.txt
FXSTREET_CONTEXT.md
nul

# Generated news archive (rebuilt from DB via Archives tab)
news_data/

# Generated EC events archive (rebuilt from DB via Archives tab)
ec_events_data/

# Generated MyFXBook calendar archive (per-day JSON, written live)
myfxbook_events_data/

# Backtest research data (regenerable via `cargo run --bin backtest_orb -- download`)
backtest_data/
