/target
/gen
.prod-build/
run_production.sh

# Environment variables with sensitive credentials
.env
.env.bak
.env.*.bak

# Python bytecode cache
__pycache__/
*.pyc
*.nbc
*.nbi

# DuckDB database and temp files
Bots_db/
*.duckdb
*.duckdb.wal

# ML model weights (large binaries — metrics/feature names are tracked)
ml/trained/*.json
ml/trained/*.pkl
ml/trained/*.pt
ml/trained/*.txt
!ml/trained/*_metrics*.json

# Generated ML feature CSVs (rebuilt via UI button)
ml/ml_unified_features.csv

# Claude Code settings
.claude/

# Econcal proxy (separate git repo)
econcal/

# Runtime artifacts
scraper_log.txt
econcal_comparison_*.txt
FXSTREET_CONTEXT.md
nul

# Generated news archive (rebuilt from DB via Archives tab) — keep the
# per-day JSON under all/ tracked, ignore any other subfolders.
news_data/*
!news_data/all/

# Generated EC events archive (rebuilt from DB via Archives tab) — keep the
# per-day JSON under all/ tracked, ignore any other subfolders.
ec_events_data/*
!ec_events_data/all/

# Backtest research data (regenerable via `cargo run --bin backtest_orb -- download`)
backtest_data/
