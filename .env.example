# cTrader API Credentials
# Copy this file to .env and fill in your actual credentials

CTRADER_CLIENT_ID=your_client_id_here
CTRADER_SECRET=your_client_secret_here
CTRADER_ACCESS_TOKEN=your_access_token_here
CTRADER_ACCOUNT_ID=your_account_id_here
CTRADER_SYMBOL=BTCUSD

# Server: "demo" (default) or "live". Live trades a real-money account.
CTRADER_ENV=demo

# Limits for automated orders (gold auto-trade loop and EURUSD bot).
# Both stop for the rest of the UTC day when either is reached.
RISK_DAILY_LOSS_PCT=5
RISK_MAX_AUTO_TRADES=10
